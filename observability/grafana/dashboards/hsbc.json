    {
      "id": 2,
      "type": "timeseries",
      "title": "QPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(http_requests_total{service=\"ml-predictor-api\", status_code=~\"2..\"}[5m]))",
          "legendFormat": "{{endpoint}} success",
          "refId": "A"
        },
        {
          "expr": "sum by (endpoint) (rate(http_requests_total{service=\"ml-predictor-api\", status_code=~\"[^2]..\"}[5m]))",
          "legendFormat": "{{endpoint}} error",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "legend": {
        "displayMode": "table",
        "placement": "bottom",
        "showLegend": true,
        "calcs": [
